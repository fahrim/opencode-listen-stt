{
  "name": "opencode-listen-stt",
  "version": "0.2.0",
  "description": "Offline voice dictation for OpenCode V2 on Windows. whisper.cpp with 99 languages, GPU-accelerated on NVIDIA (CUDA), AMD and Intel (Vulkan).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fahrim/opencode-listen-stt.git"
  },
  "homepage": "https://github.com/fahrim/opencode-listen-stt#readme",
  "bugs": {
    "url": "https://github.com/fahrim/opencode-listen-stt/issues"
  },
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "voice",
    "dictation",
    "speech-to-text",
    "stt",
    "whisper",
    "whisper-cpp",
    "vulkan",
    "cuda",
    "turkish",
    "offline"
  ],
  "oc-plugin": [
    "tui"
  ],
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.tsx"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "lib",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.26",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "2.0.26",
    "typescript": "5.9.3"
  },
  "engines": {
    "opencode": ">=2.0.0"
  }
}